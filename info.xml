<?xml version="1.0"?>
<extension key="be.calibrate.eavesdropper" type="module">
  <file>eavesdropper</file>
  <name>Eavesdropper</name>
  <description>Civicrm error logging to Redis</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Wannes De Roy</author>
    <email>wannes.deroy@claibrate</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">/civicrm/eavesdropper/settings</url>
    <url desc="Documentation">https://github.com/wannesderoy/be.calibrate.eavesdropper</url>
    <url desc="Support">https://github.com/wannesderoy/be.calibrate.eavesdropper</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2018-08-09</releaseDate>
  <version>1.0</version>
  <develStage>Beta</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments>Requires a running Redis instance</comments>
  <civix>
    <namespace>CRM/Eavesdropper</namespace>
    <format>25.10.1</format>
  </civix>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="CRM\Eavesdropper\" path="CRM/Eavesdropper"/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
